# Copy to .env for local development. In Vercel, set these as Project Environment Variables.
# All values below belong to Hope Found's own accounts — see README "Who owns each account".

# --- Google service account (Drive + Sheets) ---
# Service account JSON key, scoped to one Drive folder and one Sheet.
# Paste the full JSON as a single-line string (escape newlines in the private key as \n).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID of the shared Drive folder that contains Qualified/, Hold/, Did-Not-Qualify/ subfolders.
GOOGLE_DRIVE_FOLDER_ID=

# ID of the Google Sheet submissions are appended to (from its URL).
GOOGLE_SHEET_ID=

# --- Resend (email) ---
# API key from Hope Found's Resend account.
RESEND_API_KEY=

# Verified sending address on a hopefoundinc.com subdomain, e.g. apply@mail.hopefoundinc.com
RESEND_FROM_EMAIL=

# --- Rate limiting / anti-abuse (Phase 6) ---
# Optional: connection string for a shared store (e.g. Upstash Redis via Vercel Marketplace)
# used to track per-IP submission rate limits across function invocations.
RATE_LIMIT_STORE_URL=
